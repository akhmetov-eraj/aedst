<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declares this app as an Android TV (Leanback) app; touchscreen is
         explicitly not required so the Play Store offers it on TV devices. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".AedstTvApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Aedst"
        android:supportsRtl="true">

        <activity
            android:name=".MainTvActivity"
            android:exported="true"
            android:theme="@style/Theme.Aedst">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER, not LAUNCHER: this is what makes the
                     app appear on the Android TV home screen row instead of
                     (or in addition to) a phone launcher grid. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
