<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 (API 23-30) full-backup rules; Android 12+ uses data_extraction_rules.xml. Nothing is backed up:
     the Keystore-wrapped Tink keyset and the encrypted token store are device-bound (decisions/android). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
