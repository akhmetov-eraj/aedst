<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. The app keeps a Keystore-wrapped Tink keyset, an encrypted token store and a
  device-bound id; none of it is valid on another device, so nothing is cloud-backed-up or device-transferred
  (decisions/android: allowBackup=false). Lint check DataExtractionRules is an error (lint.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
