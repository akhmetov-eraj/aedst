<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (cloud backup and device-to-device transfer). Same exclusion
     as backup_rules.xml, kept in sync deliberately rather than shared, since
     the two schemas differ. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aedst_encrypted_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aedst_encrypted_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
