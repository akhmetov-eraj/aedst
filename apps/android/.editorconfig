root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = intellij_idea
ktlint_standard_no-wildcard-imports = enabled
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,proto}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Design-system theme tokens keep their short file names (restructured separately).
[core/ui/src/main/kotlin/**/theme/{Elevation,Spacing}.kt]
ktlint_standard_filename = disabled
