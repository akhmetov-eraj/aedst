{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "config-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "config-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "base",
      "description": "Windows, MSVC 19.37+ (VS 2022 17.7+). Run from a VS Developer prompt or after vcvars64.bat so Ninja finds cl.exe.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "gcc-base",
      "hidden": true,
      "inherits": "base",
      "description": "Linux, GCC 13+.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "base",
      "description": "Linux, Clang 17+ with libstdc++ 13+ (std::expected).",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "san-asan",
      "hidden": true,
      "description": "AddressSanitizer + UBSan (MSVC: ASan only). Debug, LTO off. See cmake/AedstSanitizers.cmake.",
      "cacheVariables": {
        "AEDST_SANITIZER": "asan-ubsan",
        "AEDST_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "san-tsan",
      "hidden": true,
      "description": "ThreadSanitizer. Debug, LTO off. See cmake/AedstSanitizers.cmake.",
      "cacheVariables": {
        "AEDST_SANITIZER": "tsan",
        "AEDST_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (host default compiler)",
      "inherits": ["base", "config-debug"]
    },
    {
      "name": "release",
      "displayName": "Release (host default compiler)",
      "inherits": ["base", "config-release"]
    },
    {
      "name": "bench",
      "displayName": "Release + tests + Qt Test benchmarks (host default compiler)",
      "inherits": ["base", "config-release"],
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "AEDST_BUILD_BENCHMARKS": "ON",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "OFF"
      }
    },
    { "name": "msvc-debug", "displayName": "Debug (MSVC)", "inherits": ["msvc-base", "config-debug"] },
    { "name": "msvc-release", "displayName": "Release (MSVC)", "inherits": ["msvc-base", "config-release"] },
    { "name": "gcc-debug", "displayName": "Debug (GCC)", "inherits": ["gcc-base", "config-debug"] },
    { "name": "gcc-release", "displayName": "Release (GCC)", "inherits": ["gcc-base", "config-release"] },
    { "name": "clang-debug", "displayName": "Debug (Clang)", "inherits": ["clang-base", "config-debug"] },
    { "name": "clang-release", "displayName": "Release (Clang)", "inherits": ["clang-base", "config-release"] },
    { "name": "gcc-asan", "displayName": "Debug + ASan/UBSan (GCC)", "inherits": ["gcc-base", "config-debug", "san-asan"] },
    { "name": "clang-asan", "displayName": "Debug + ASan/UBSan (Clang)", "inherits": ["clang-base", "config-debug", "san-asan"] },
    { "name": "clang-tsan", "displayName": "Debug + TSan (Clang)", "inherits": ["clang-base", "config-debug", "san-tsan"] },
    { "name": "msvc-asan", "displayName": "Debug + ASan (MSVC)", "inherits": ["msvc-base", "config-debug", "san-asan"] },
    {
      "name": "coverage",
      "displayName": "Debug + gcov coverage (GCC); report via the coverage target",
      "inherits": ["gcc-base", "config-debug"],
      "cacheVariables": {
        "AEDST_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "bench", "configurePreset": "bench" },
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "gcc-asan", "configurePreset": "gcc-asan" },
    { "name": "clang-asan", "configurePreset": "clang-asan" },
    { "name": "clang-tsan", "configurePreset": "clang-tsan" },
    { "name": "msvc-asan", "configurePreset": "msvc-asan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "coverage-report", "configurePreset": "coverage", "targets": ["coverage"] }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    {
      "name": "test-asan-unix",
      "hidden": true,
      "inherits": "test-base",
      "description": "Run-time options for ASan/UBSan/LSan on Linux; suppressions live in cmake/sanitizers/.",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:detect_stack_use_after_return=1",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/cmake/sanitizers/lsan.supp:print_suppressions=0",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1:suppressions=${sourceDir}/cmake/sanitizers/ubsan.supp"
      }
    },
    {
      "name": "test-asan-msvc",
      "hidden": true,
      "inherits": "test-base",
      "description": "MSVC ASan has no LSan/UBSan and no suppression files.",
      "environment": {
        "ASAN_OPTIONS": "strict_string_checks=1"
      }
    },
    {
      "name": "test-tsan",
      "hidden": true,
      "inherits": "test-base",
      "environment": {
        "TSAN_OPTIONS": "second_deadlock_stack=1:halt_on_error=1:suppressions=${sourceDir}/cmake/sanitizers/tsan.supp"
      }
    },
    { "name": "debug", "inherits": "test-base", "configurePreset": "debug" },
    { "name": "msvc-debug", "inherits": "test-base", "configurePreset": "msvc-debug" },
    { "name": "gcc-debug", "inherits": "test-base", "configurePreset": "gcc-debug" },
    { "name": "clang-debug", "inherits": "test-base", "configurePreset": "clang-debug" },
    { "name": "gcc-asan", "inherits": "test-asan-unix", "configurePreset": "gcc-asan" },
    { "name": "clang-asan", "inherits": "test-asan-unix", "configurePreset": "clang-asan" },
    { "name": "clang-tsan", "inherits": "test-tsan", "configurePreset": "clang-tsan" },
    { "name": "msvc-asan", "inherits": "test-asan-msvc", "configurePreset": "msvc-asan" },
    { "name": "coverage", "inherits": "test-base", "configurePreset": "coverage" },
    {
      "name": "debug-unit",
      "inherits": "debug",
      "filter": { "include": { "label": "unit" } }
    },
    {
      "name": "debug-qttest",
      "inherits": "debug",
      "filter": { "include": { "label": "qttest" } }
    },
    {
      "name": "debug-qmltest",
      "inherits": "debug",
      "filter": { "include": { "label": "qmltest" } }
    },
    { "name": "msvc-debug-qmltest", "inherits": "msvc-debug", "filter": { "include": { "label": "qmltest" } } },
    { "name": "gcc-debug-qmltest", "inherits": "gcc-debug", "filter": { "include": { "label": "qmltest" } } },
    { "name": "clang-debug-qmltest", "inherits": "clang-debug", "filter": { "include": { "label": "qmltest" } } },
    {
      "name": "bench",
      "inherits": "test-base",
      "configurePreset": "bench",
      "filter": { "include": { "label": "bench" } },
      "output": { "outputOnFailure": true, "verbosity": "verbose" }
    }
  ],
  "workflowPresets": [
    {
      "name": "wf-msvc-debug",
      "steps": [
        { "type": "configure", "name": "msvc-debug" },
        { "type": "build", "name": "msvc-debug" },
        { "type": "test", "name": "msvc-debug" }
      ]
    },
    {
      "name": "wf-gcc-debug",
      "steps": [
        { "type": "configure", "name": "gcc-debug" },
        { "type": "build", "name": "gcc-debug" },
        { "type": "test", "name": "gcc-debug" }
      ]
    },
    {
      "name": "wf-clang-debug",
      "steps": [
        { "type": "configure", "name": "clang-debug" },
        { "type": "build", "name": "clang-debug" },
        { "type": "test", "name": "clang-debug" }
      ]
    },
    {
      "name": "wf-gcc-asan",
      "steps": [
        { "type": "configure", "name": "gcc-asan" },
        { "type": "build", "name": "gcc-asan" },
        { "type": "test", "name": "gcc-asan" }
      ]
    },
    {
      "name": "wf-clang-asan",
      "steps": [
        { "type": "configure", "name": "clang-asan" },
        { "type": "build", "name": "clang-asan" },
        { "type": "test", "name": "clang-asan" }
      ]
    },
    {
      "name": "wf-clang-tsan",
      "steps": [
        { "type": "configure", "name": "clang-tsan" },
        { "type": "build", "name": "clang-tsan" },
        { "type": "test", "name": "clang-tsan" }
      ]
    },
    {
      "name": "wf-msvc-asan",
      "steps": [
        { "type": "configure", "name": "msvc-asan" },
        { "type": "build", "name": "msvc-asan" },
        { "type": "test", "name": "msvc-asan" }
      ]
    },
    {
      "name": "wf-coverage",
      "steps": [
        { "type": "configure", "name": "coverage" },
        { "type": "build", "name": "coverage" },
        { "type": "build", "name": "coverage-report" }
      ]
    }
  ]
}
