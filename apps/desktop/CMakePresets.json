{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Conan)",
      "description": "Run `conan install . --output-folder=build --build=missing -s build_type=Debug` first.",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/build/debug/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Conan)",
      "description": "Run `conan install . --output-folder=build --build=missing -s build_type=Release` first.",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/build/release/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    {
      "name": "debug-unit",
      "inherits": "debug",
      "filter": { "include": { "label": "unit" } }
    },
    {
      "name": "debug-qttest",
      "inherits": "debug",
      "filter": { "include": { "label": "qttest" } }
    }
  ]
}
