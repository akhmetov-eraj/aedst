---
# Run via scripts/run-clang-tidy.sh (blocking CI gate + checked-in baseline, see
# CLANG_TIDY_BASELINE.md) against a clang preset, e.g.
#   ./scripts/run-clang-tidy.sh build/clang-debug
# moc/rcc/proto output lives under build/** and is excluded by the source-root path filter.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-type-vararg,
  -cert-err58-cpp,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-implicit-bool-conversion,
  -readability-convert-member-functions-to-static,
  -readability-named-parameter,
  -readability-uppercase-literal-suffix,
  -readability-use-anyofallof,
  -misc-const-correctness,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -modernize-use-trailing-return-type,
  -modernize-use-designated-initializers,
  -modernize-avoid-c-arrays,
  -performance-enum-size

# Why the disabled checks:
# - cppcoreguidelines-owning-memory: Qt's ownership model is parent/child
#   (`new QObject(parent)` is owned by the parent). gsl::owner<> can't express
#   that, so every idiomatic Qt allocation would be flagged.
# - cppcoreguidelines-pro-bounds-array-to-pointer-decay: fires inside Q_OBJECT,
#   Q_PROPERTY, qDebug() and spdlog format-string macros we don't control.
# - cppcoreguidelines-pro-type-reinterpret-cast: the only reinterpret_casts are
#   at C API boundaries (sqlite3 text columns, OpenSSL/DPAPI byte buffers).
# - bugprone-easily-swappable-parameters: noisy for DTO-shaped constructors.
# - cppcoreguidelines-avoid-magic-numbers: theme tokens and HTTP status codes.
# - modernize-use-trailing-return-type: style preference, not a defect.
# - cppcoreguidelines-non-private-member-variables-in-classes: aggregates/DTOs
#   (ApiError, Frame, CallOptions) are plain structs by design.
# - cppcoreguidelines-avoid-const-or-ref-data-members: fires on the deliberate
#   const/reference members in test fixtures and Qt slot closures.
# - cppcoreguidelines-macro-usage: Qt (Q_OBJECT, QTEST_*) and the gtest main macro.
# - cppcoreguidelines-pro-type-vararg: fires inside qDebug()/gtest/QTest macros.
# - modernize-avoid-c-arrays: test tables and Qt Test data rows use small C arrays.
# - performance-enum-size: narrowing enum underlying types buys nothing here.
# - cert-err58-cpp: fires on every namespace-scope `static const QString`/QStringLiteral
#   and std::string table; none of them can throw in practice and the alternative
#   (function-local statics everywhere) is noise.
# - readability-identifier-length / magic-numbers / function-cognitive-complexity:
#   loop indices, HTTP status codes and protocol parsers; review judgement, not a gate.
# - readability-implicit-bool-conversion: Qt and protobuf accessors return int/pointers
#   used as conditions throughout.
# - readability-convert-member-functions-to-static / named-parameter /
#   uppercase-literal-suffix / use-anyofallof: style preferences that fight Qt slot and
#   override signatures and the clang-format style.
#
# - misc-const-correctness: flags every local that could be const (hundreds of Qt signal/lambda captures); review
#   judgement, not a gate. misc-non-private-member-variables-in-classes duplicates the disabled cppcoreguidelines
#   check (DTO structs). misc-no-recursion: the JSON/QML tree walkers and the protobuf visitors recurse by design.
# - misc-include-cleaner is ON but told to ignore Qt and generated headers (IgnoreHeaders below): Qt's umbrella headers
#   (<QString> -> qstring.h, <QtQml/qqmlregistration.h>) and moc/protobuf output cannot be mapped to the declaring
#   header by include-cleaner, so every Qt include would be reported as unused.
# - concurrency-*: on (concurrency-mt-unsafe flags getenv/localtime/strerror-style calls; startup-only uses carry
#   // NOLINT(concurrency-mt-unsafe) with a reason). Naming and concurrency findings are errors (WarningsAsErrors).
#
# readability-identifier-naming below stays the real naming gate (CONVENTIONS.md).
#
# Scope note: the Qt moc output is never analysed (it lives under build/**), so no
# moc-specific exclusions are needed beyond the path filter.
#
# Generated code (protoc output under build/**/generated, moc/rcc autogen) and
# third_party/ are never linted: HeaderFilterRegex only admits Modules/ and App/
# headers, run-clang-tidy is filtered to Modules/|App/, and the AedstContractProto
# target clears CXX_CLANG_TIDY for AEDST_ENABLE_CLANG_TIDY=ON builds.
WarningsAsErrors: 'readability-identifier-naming,concurrency-*'
HeaderFilterRegex: '.*/(Modules|App)/.*\.hpp$'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: misc-include-cleaner.IgnoreHeaders
    value: '(.*/)?Q[A-Za-z0-9_]+;(.*/)?q[a-z0-9_]+\.h;(.*/)?moc_.*;(.*/)?mocs_compilation.*;.*_autogen/.*;.*\.pb\.h;google/protobuf/.*'
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'std::function;.*Completion'
...
