// Windows resource script for aedst-desktop.exe, configured by App/CMakeLists.txt
// into <build>/App/aedst-desktop.rc. Provides the VERSIONINFO block (Explorer's
// Details tab, installer/updater version checks, WER) and the application icon.
#include <winver.h>

@AEDST_WIN_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @AEDST_VERSION_MAJOR@,@AEDST_VERSION_MINOR@,@AEDST_VERSION_PATCH@,0
 PRODUCTVERSION @AEDST_VERSION_MAJOR@,@AEDST_VERSION_MINOR@,@AEDST_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AEDST"
            VALUE "FileDescription", "AEDST desktop client"
            VALUE "FileVersion", "@AEDST_VERSION@"
            VALUE "InternalName", "aedst-desktop"
            VALUE "LegalCopyright", "Copyright (C) AEDST"
            VALUE "OriginalFilename", "aedst-desktop.exe"
            VALUE "ProductName", "AEDST"
            VALUE "ProductVersion", "@AEDST_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
