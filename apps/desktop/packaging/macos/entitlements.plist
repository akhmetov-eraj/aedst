<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened-runtime, notarized (Developer ID, non-App-Store) build.
  Used by packaging/macos/sign-and-notarize.sh (codesign with an entitlements file).
-->
<plist version="1.0">
<dict>
    <!-- Hardened runtime itself is enabled with the codesign options flag "runtime", not here. -->

    <!-- Outgoing connections (Connect/HTTP to the AEDST server). Only enforced under the
         App Sandbox, harmless and future-proof outside it. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Qt Quick's QML JIT (V4) maps executable memory with MAP_JIT; the hardened
         runtime kills the process without this. Remove if the QML engine is switched to
         interpreter-only (QV4_FORCE_INTERPRETER / QML_DISABLE_JIT). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
