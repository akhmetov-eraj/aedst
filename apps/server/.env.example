AEDST_ENV=development

AEDST_HTTP_ADDR=:8080
# Optional Prometheus scrape endpoint (/metrics) on a separate listener.
# Leave empty to disable; OTLP export (below) does not need it.
AEDST_METRICS_ADDR=
# Browser origins allowed to call the ConnectRPC API directly (comma-separated).
# apps/web runs on :3000 in local dev; add production/staging web origins here.
AEDST_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the server (0 = none). Needed for the
# per-IP rate limit to see real client addresses; a wrong value is spoofable.
AEDST_TRUSTED_PROXY_HOPS=0
# Seconds /readyz reports "draining" before the listener stops (set to your
# load balancer's health-check interval x threshold in production).
AEDST_SHUTDOWN_DRAIN_SECONDS=0

AEDST_DATABASE_URL=postgres://aedst:aedst@localhost:5432/aedst?sslmode=disable

# Request pool size and the separate pool for background work (River jobs and
# event consumers). Budget: replicas x (MAX_CONNS + JOBS_MAX_CONNS)
# must stay below Postgres max_connections / PgBouncer's server pool.
AEDST_DATABASE_MAX_CONNS=20
AEDST_DATABASE_JOBS_MAX_CONNS=30
# Optional direct (non-pooled) DSN for the jobs pool. Set it when
# AEDST_DATABASE_URL points at PgBouncer in transaction mode: River uses
# LISTEN/NOTIFY and platform/lock uses session advisory locks.
# AEDST_DATABASE_DIRECT_DSN=postgres://aedst:aedst@localhost:5432/aedst?sslmode=disable
# Optional read replica for lag-tolerant reads (search); empty = read from the primary.
# AEDST_DATABASE_READ_URL=
# AEDST_DATABASE_READ_MAX_CONNS=0
# What sits in front of AEDST_DATABASE_URL: none (default) | pgbouncer (transaction
# pooling; compose profile `pgbouncer`, CloudNativePG Pooler on Kubernetes).
# pgbouncer forces pgx QueryExecModeCacheDescribe (no DSN parameter needed), stops
# sending statement_timeout as a startup parameter (set it on the role), and
# REQUIRES AEDST_DATABASE_DIRECT_DSN or AEDST_JOBS_POLL_ONLY=true (startup fails
# otherwise): River's LISTEN/NOTIFY does not work through transaction pooling.
# AEDST_DATABASE_POOLER=none
# River without LISTEN/NOTIFY (polling). Only for a jobs pool that has no direct DSN.
# AEDST_JOBS_POLL_ONLY=false

# Integration events are River jobs inserted in the producer's transaction
# (ADR-0014). How long River keeps finished jobs before its cleaner deletes
# them; discarded deliveries are the dead-letter list, so they live longest.
AEDST_JOBS_COMPLETED_RETENTION_HOURS=24
AEDST_JOBS_CANCELLED_RETENTION_HOURS=24
AEDST_JOBS_DISCARDED_RETENTION_HOURS=168

# Oldest client release still supported, per platform (web|android|apple|
# desktop); older self-identifying clients get CLIENT_UPGRADE_REQUIRED
# (ADR-0009). Empty = no enforcement.
AEDST_MIN_CLIENT_VERSIONS=
# Soft counterpart: the release clients should move to (nothing is rejected;
# reported by CapabilitiesService/GetCapabilities). Same format.
AEDST_RECOMMENDED_CLIENT_VERSIONS=
# Operator feature flags for GetCapabilities, JSON: {"new_search":{"enabled":true,"params":{"rollout_percent":"25"}}}
AEDST_FEATURES=

# Valkey (cache + rate limiting). Replaces the former AEDST_REDIS_* variables.
# Optional at runtime: the server starts and stays ready without it (/readyz
# reports "degraded") and the limiters below fail open.
AEDST_VALKEY_ADDR=localhost:6379

# Protection. Limits are per minute; 0 disables.
#   auth: per client address on register/login/refresh/logout
#   login: per (account, address); the per-account ceiling is 10x this
#   api: per authenticated user on every other RPC
AEDST_AUTH_RATE_LIMIT_PER_MINUTE=30
AEDST_LOGIN_RATE_LIMIT_PER_MINUTE=10
AEDST_API_RATE_LIMIT_PER_MINUTE=1200
# Concurrent requests per instance before excess is shed with 429 (0 = off).
AEDST_MAX_IN_FLIGHT=1024
# gRPC server reflection (grpcurl schema discovery). Off in deployed
# environments: it publishes the whole API surface.
AEDST_GRPC_REFLECTION_ENABLED=true
# Authentication is IdP-first: set AEDST_OIDC_* below (ZITADEL by default).
# The server refuses to start with neither OIDC nor first-party auth.
# Built-in first-party auth (email + password, argon2id) is OFF. There are no
# production users, so it exists only for a quick local run without an IdP and
# can be deleted any time (ADR-0017, "Decision on removal"). To use it locally,
# uncomment the next line (clients still call AuthService, the k6 scripts and the
# Bruno collection register through it). In development no sunset date is
# needed; staging/production would need AEDST_AUTH_FIRST_PARTY_SUNSET (RFC 3339
# date) and should not enable it at all.
AEDST_AUTH_FIRST_PARTY_ENABLED=false
# AEDST_AUTH_FIRST_PARTY_ENABLED=true
# HS256 secret, >= 32 bytes. Production: openssl rand -base64 48
AEDST_JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789
AEDST_JWT_PREVIOUS_SIGNING_KEY=

# OIDC resource server: accept access tokens from an external identity
# provider. ZITADEL is the template default (any OIDC provider works). Empty = off.
# Local ZITADEL (task up PROFILES="--profile idp", then deployments/zitadel/bootstrap.sh,
# which prints the audience = ZITADEL project id):
#   AEDST_OIDC_ISSUER=http://localhost:8085
#   AEDST_OIDC_AUDIENCE=<project id printed by bootstrap.sh>
#   AEDST_OIDC_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
#   AEDST_OIDC_ROLES_ORG=<organisation id>   # optional: only roles granted in this org count
# Verified against ZITADEL v4.19.4: human tokens carry the generic claim above; machine
# users (client_credentials / JWT profile) carry roles ONLY in
# urn:zitadel:iam:org:project:<projectId>:roles and only when the scope
# urn:zitadel:iam:org:projects:roles is requested. Service callers that need roles must
# use a deployment whose AEDST_OIDC_ROLES_CLAIM is that per-project claim.
# Keycloak instead: ROLES_CLAIM=realm_access.roles (ROLES_ORG is ignored for array claims)
AEDST_OIDC_ISSUER=
AEDST_OIDC_AUDIENCE=
AEDST_OIDC_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
AEDST_OIDC_ROLES_ORG=

# --- observability (OpenTelemetry) -------------------------------------------
AEDST_LOG_LEVEL=info
AEDST_LOG_FORMAT=text
AEDST_SERVICE_NAME=aedst-server
# Standard OTLP variables, read by the OpenTelemetry SDK. Unset = no export.
# Local Grafana otel-lgtm (docker compose --profile observability up -d):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Grafana Cloud / SigNoz / HyperDX: their OTLP endpoint + headers, e.g.
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 instance:token>
OTEL_EXPORTER_OTLP_ENDPOINT=

# Role-based access: procedures restricted to callers holding one of the roles,
# "/pkg.Service/Method=role|role,/pkg.Other/Method=role". Roles come from the
# token (first-party sessions carry "user"; an OIDC provider supplies its own,
# see AEDST_OIDC_ROLES_CLAIM). A typo or a public procedure fails startup.
# Built-in default (always applied unless overridden for the same key):
#   /aedst.admin.v1.AdminService/*=admin
# "/pkg.Service/*" covers every method of a service; an exact entry wins.
# Otherwise every authenticated caller may call every RPC.
# AEDST_ROLE_POLICY=/aedst.tasks.v1.TasksService/DeleteTask=admin|support
AEDST_ROLE_POLICY=

# --- HTTP hardening (defaults shown) -------------------------------------------
# AEDST_HTTP_READ_HEADER_TIMEOUT_SECONDS=5
# AEDST_HTTP_READ_TIMEOUT_SECONDS=30
# Must exceed AEDST_REQUEST_TIMEOUT_SECONDS; streaming RPCs clear it per request.
# AEDST_HTTP_WRITE_TIMEOUT_SECONDS=60
# AEDST_HTTP_IDLE_TIMEOUT_SECONDS=120
# AEDST_HTTP_MAX_HEADER_BYTES=65536
# TLS normally terminates at the ingress/load balancer (the server then speaks
# h2c). Set both to serve TLS (min 1.2) in-process instead.
# AEDST_TLS_CERT_FILE=
# AEDST_TLS_KEY_FILE=
# Strict-Transport-Security on HTTPS requests (0 disables).
# AEDST_HSTS_MAX_AGE_SECONDS=63072000
# Reject Connect unary calls without Connect-Protocol-Version (CSRF defense in depth).
# AEDST_REQUIRE_CONNECT_PROTOCOL_HEADER=true

# --- background jobs ---------------------------------------------------------
# River queues this process works: queue=workers. A dedicated media worker
# deployment runs "media=4", API-only replicas "default=50"; empty = insert-only.
AEDST_JOBS_QUEUES=default=50,media=2

# --- object storage (MediaService). Empty bucket = media disabled. ----------
# Local MinIO (docker compose --profile minio up -d --wait):
AEDST_STORAGE_PROVIDER=minio
AEDST_STORAGE_ENDPOINT=http://localhost:9000
AEDST_STORAGE_BUCKET=
AEDST_STORAGE_ACCESS_KEY_ID=aedst
AEDST_STORAGE_SECRET_ACCESS_KEY=aedst-dev-secret
# AWS S3: AEDST_STORAGE_PROVIDER=s3 AEDST_STORAGE_REGION=eu-central-1 (credentials
# from the default chain / IRSA when the keys are empty).
# Cloudflare R2: AEDST_STORAGE_PROVIDER=r2
#   AEDST_STORAGE_ENDPOINT=https://<account id>.r2.cloudflarestorage.com (region "auto")
# AEDST_STORAGE_PUBLIC_ENDPOINT=   # host clients use for presigned URLs, if different
# AEDST_STORAGE_PATH_STYLE=        # true|false, overrides the provider default
# AEDST_STORAGE_UPLOAD_URL_TTL_SECONDS=900
# AEDST_STORAGE_DOWNLOAD_URL_TTL_SECONDS=3600

# --- media processing ----------------------------------------------------------
# AEDST_MEDIA_MAX_IMAGE_BYTES=20971520
# AEDST_MEDIA_MAX_VIDEO_BYTES=524288000
# AEDST_MEDIA_MAX_AUDIO_BYTES=104857600
# AEDST_MEDIA_MAX_DOCUMENT_BYTES=52428800
# AEDST_MEDIA_MAX_IMAGE_PIXELS=50000000
# Video posters + audio/video metadata need both (e.g. /usr/bin/ffmpeg).
# AEDST_MEDIA_FFMPEG_PATH=
# AEDST_MEDIA_FFPROBE_PATH=
# AEDST_MEDIA_PROCESS_TIMEOUT_SECONDS=120
# AEDST_MEDIA_PENDING_UPLOAD_TTL_HOURS=24

# --- push notifications (each provider disabled while unset) -------------------
# Web Push (VAPID): npx web-push generate-vapid-keys
# AEDST_PUSH_VAPID_PUBLIC_KEY=
# AEDST_PUSH_VAPID_PRIVATE_KEY=
# AEDST_PUSH_VAPID_SUBJECT=mailto:ops@example.com
# FCM HTTP v1: service-account key JSON (inline or a file path).
# AEDST_PUSH_FCM_CREDENTIALS_FILE=
# AEDST_PUSH_FCM_CREDENTIALS_JSON=
# AEDST_PUSH_FCM_PROJECT_ID=
# APNs token auth (.p8 key).
# AEDST_PUSH_APNS_KEY_ID=
# AEDST_PUSH_APNS_TEAM_ID=
# AEDST_PUSH_APNS_PRIVATE_KEY_FILE=
# AEDST_PUSH_APNS_TOPIC=com.example.app
# AEDST_PUSH_TIMEOUT_SECONDS=10

# --- tasks / retention -----------------------------------------------------------
# AEDST_TASKS_DUE_SOON_LEAD_MINUTES=60
# AEDST_RETENTION_NOTIFICATION_DAYS=90
# AEDST_RETENTION_AUDIT_DAYS=365

# --- imgproxy: on-demand image delivery (ADR-0015). Off by default. ----------
# The server only SIGNS imgproxy URLs (presets thumb_64, avatar_256, card_400,
# feed_800x600, story_1080x1350); imgproxy reads the sanitized originals from
# AEDST_STORAGE_BUCKET and renders WebP/AVIF/JPEG per the Accept header.
# Local: docker compose --profile media up -d --wait (imgproxy on :8086), then
# AEDST_IMGPROXY_ENABLED=true
# AEDST_IMGPROXY_URL=http://localhost:8086
# AEDST_IMGPROXY_KEY=61656473742d6465762d696d6770726f78792d6b6579     # hex, must equal IMGPROXY_KEY
# AEDST_IMGPROXY_SALT=61656473742d6465762d696d6770726f78792d73616c74  # hex, must equal IMGPROXY_SALT
# AEDST_IMGPROXY_URL_TTL_SECONDS=3600                                # 0 = URLs never expire
# Production: generate fresh values (e.g. `openssl rand -hex 32`) and keep them in the secret store.
# Image processing needs a binary built with -tags vips (task build:vips / the Docker image).

# --- Google Play Integrity verification (modules/integrity, ADR-0018). Off by default. ---
# STANDARD API: the Android app sends the opaque token to IntegrityService/VerifyIntegrityToken;
# the server decodes it via playintegrity.googleapis.com and applies the policy below.
# Needs: Play Console app linked to a Cloud project with the Play Integrity API enabled.
# AEDST_INTEGRITY_ENABLED=true
# AEDST_INTEGRITY_ALLOWED_PACKAGES=com.aedst.android            # comma separated applicationIds (add .debug if needed)
# Service account key of the linked Cloud project (the client requests the playintegrity scope itself), inline or file.
# Both empty = Application Default Credentials (workload identity / GOOGLE_APPLICATION_CREDENTIALS).
# AEDST_INTEGRITY_CREDENTIALS_FILE=
# AEDST_INTEGRITY_CREDENTIALS_JSON=
# AEDST_INTEGRITY_MAX_TOKEN_AGE_SECONDS=300
# AEDST_INTEGRITY_MAX_FUTURE_SKEW_SECONDS=30
# AEDST_INTEGRITY_MIN_DEVICE_LEVEL=device                        # basic | device | strong
# AEDST_INTEGRITY_REQUIRE_PLAY_RECOGNIZED=true                   # false for sideloaded / internal builds
# AEDST_INTEGRITY_REQUIRE_LICENSED=false
# AEDST_INTEGRITY_ALLOW_TESTING_RESPONSES=false                  # rejected in staging/production
# AEDST_INTEGRITY_RATE_LIMIT_PER_MINUTE=10                       # per user; Google's decode quota is shared (10k/day default)
# AEDST_INTEGRITY_TIMEOUT_SECONDS=10

# --- Apple App Attest verification (modules/appattest, ADR-0016). Off by default. ---
# The Apple app calls AppAttestService/CreateChallenge, then Enroll (once per key), then VerifyAssertion.
# Verification is local (embedded Apple App Attestation Root CA); nothing is contacted. Needs the appattest migration.
# AEDST_APPATTEST_ENABLED=true
# AEDST_APPATTEST_TEAM_ID=ABCDE12345                               # 10-char Apple Developer Team ID (App ID prefix)
# AEDST_APPATTEST_ALLOWED_BUNDLE_IDS=com.aedst.apple               # comma separated; App ID checked = <TEAM_ID>.<bundle id>
# AEDST_APPATTEST_ALLOW_DEVELOPMENT=false                          # accept Xcode-run (development) keys; rejected in staging/production
# AEDST_APPATTEST_RATE_LIMIT_PER_MINUTE=10                         # per user: CreateChallenge + Enroll
# AEDST_APPATTEST_ASSERTION_RATE_LIMIT_PER_MINUTE=120              # per user: VerifyAssertion
# AEDST_APPATTEST_KEY_RETENTION_DAYS=365                           # keys unused this long are purged (the app re-enrolls)

# --- Tunables with sane defaults (listed so every variable the server reads is documented). ---
# Pool and server timeouts.
# AEDST_DATABASE_MIN_CONNS=2
# AEDST_DATABASE_MAX_CONN_LIFETIME_MINUTES=60
# AEDST_DATABASE_MAX_CONN_IDLE_MINUTES=15
# AEDST_DATABASE_STATEMENT_TIMEOUT_MS=15000
# AEDST_DATABASE_IDLE_IN_TX_TIMEOUT_MS=30000
# AEDST_SHUTDOWN_TIMEOUT_SECONDS=15                                # whole shutdown budget; River gets it minus 2s (SoftStopTimeout), after which running jobs are cancelled.
#   RescueStuckJobsAfter is fixed at the longest worker Timeout (media: 10m) + 5m, so a rolling restart never re-runs a healthy long job.
#   Keep terminationGracePeriodSeconds > drain + this value (the Helm chart computes it).
# AEDST_MAX_REQUEST_BYTES=1048576
# Valkey (optional; rate limiting fails open).
# AEDST_VALKEY_PASSWORD=
# AEDST_VALKEY_DB=0
# First-party token lifetimes (only with AEDST_AUTH_FIRST_PARTY_ENABLED=true).
# AEDST_ACCESS_TOKEN_TTL_MINUTES=15
# AEDST_REFRESH_TOKEN_TTL_HOURS=720
# External OIDC provider details (AEDST_OIDC_ISSUER / AUDIENCE are above).
# AEDST_OIDC_JWKS_URL=                                             # empty = discovered from the issuer
# AEDST_OIDC_ALGORITHMS=RS256,ES256,EdDSA
# AEDST_OIDC_CLOCK_SKEW_SECONDS=30
# Retention of append-only tables (see also NOTIFICATION_DAYS / AUDIT_DAYS above).
# AEDST_RETENTION_INTERVAL_MINUTES=60
# AEDST_RETENTION_IDEMPOTENCY_HOURS=48
# AEDST_RETENTION_TOMBSTONE_HOURS=336                              # must exceed the event retry window (~4.3 h)
# AEDST_RETENTION_SESSION_HOURS=720
# Push: APNs token key inline (the *_FILE variant is documented with the push settings above).
# AEDST_PUSH_APNS_PRIVATE_KEY=
# Telemetry: trace-only OTLP endpoint (overrides OTEL_EXPORTER_OTLP_ENDPOINT for traces).
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Database-per-module (extraction step, see docs/content/server/runbook-extract-service.md).
# A module that asks for env.PoolFor/JobsPoolFor (integrity and appattest today) runs on its own
# database when AEDST_DATABASE_URL_<MODULE> is set; _JOBS is its direct/background connection.
# An unknown module name fails startup. Apply that module's migrations to that database.
# AEDST_DATABASE_URL_INTEGRITY=postgres://aedst:aedst@localhost:5432/aedst_integrity?sslmode=disable
# AEDST_DATABASE_URL_INTEGRITY_JOBS=postgres://aedst:aedst@localhost:5432/aedst_integrity?sslmode=disable

# Transport security (required in staging/production unless explicitly opted out).
# Valkey over TLS 1.2+: server certificate verified against the CA (default: system roots).
# AEDST_VALKEY_TLS=true
# AEDST_VALKEY_TLS_SERVER_NAME=                                    # default: the host of AEDST_VALKEY_ADDR
# AEDST_VALKEY_TLS_CA_FILE=/etc/valkey-tls/ca.crt
# AEDST_VALKEY_ALLOW_PLAINTEXT=false                               # explicit opt-out for a trusted network segment
# PostgreSQL: every DSN needs sslmode=verify-full (or verify-ca) with sslrootcert=... in staging/production.
# AEDST_DATABASE_ALLOW_UNVERIFIED_TLS=false                        # explicit opt-out
# Per-IP budget of failed authentications (missing/invalid token) before RESOURCE_EXHAUSTED; 0 disables.
# AEDST_AUTH_FAIL_RATE_LIMIT_PER_MINUTE=60
# net/http/pprof under /debug/pprof/ on the metrics listener (needs AEDST_METRICS_ADDR); reach it by port-forward only.
# AEDST_PPROF_ENABLED=false
# JOSE typ values accepted for an access token (ID, logout and other tokens are refused). Keycloak sends JWT.
# AEDST_OIDC_TOKEN_TYPES=at+jwt,JWT
