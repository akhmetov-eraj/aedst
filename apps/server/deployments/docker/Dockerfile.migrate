# Migration image used by the Helm pre-install/pre-upgrade hook Job
# (deployments/helm/aedst-server/templates/migration-job.yaml). Contains the
# goose CLI plus migrations/<module>/*.sql. Build context is apps/server:
#   docker build -f deployments/docker/Dockerfile.migrate -t aedst-server-migrate .
#
# Alpine (not distroless) because the Job loops over module directories in sh.
# The goose version must track github.com/pressly/goose/v3 in go.mod.
FROM golang:1.27-alpine AS build
RUN CGO_ENABLED=0 GOBIN=/out go install github.com/pressly/goose/v3/cmd/goose@v3.28.0

FROM alpine:3.22 AS runtime
COPY --from=build /out/goose /usr/local/bin/goose
COPY migrations /migrations
USER 65532:65532
ENTRYPOINT ["goose"]
