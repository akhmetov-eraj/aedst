    {
      "id": 13,
      "type": "timeseries",
      "title": "Oldest ready job age",
      "description": "Healthy < 2 s; alert AedstJobsLagging above 30 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
