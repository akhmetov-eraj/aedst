        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "max by (pool) (aedst_db_pool_connections{state=\"acquired\"})",
          "legendFormat": "{{pool}} acquired"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B",
          "expr": "max by (pool) (aedst_db_pool_connections{state=\"max\"})",
          "legendFormat": "{{pool}} max"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Time spent waiting for a connection",
      "description": "Seconds of waiting per second; above 0.1 the pool is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
