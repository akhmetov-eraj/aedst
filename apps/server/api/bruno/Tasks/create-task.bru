meta {
  name: Create Task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/aedst.tasks.v1.TasksService/CreateTask
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Write the reference module docs",
    "description": "Explain how to copy the tasks module for a new one.",
    "priority": "TASK_PRIORITY_HIGH",
    "dueDate": "2099-01-01T00:00:00Z"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("taskId", res.body.task.id);
  }
}

docs {
  Requires `Authorization: Bearer {{accessToken}}` (set on the `Tasks`
  folder, inherited here). Run `Auth/Register` or `Auth/Login` first.
}
