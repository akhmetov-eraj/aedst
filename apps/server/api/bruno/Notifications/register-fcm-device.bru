meta {
  name: Register FCM Device
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/aedst.notifications.v1.NotificationsService/RegisterPushDevice
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "platform": "PUSH_PLATFORM_FCM",
    "token": "fcm-token-from-firebase-messaging",
    "deviceName": "Pixel (Bruno)",
    "locale": "en"
  }
}

assert {
  res.status: eq 200
}
