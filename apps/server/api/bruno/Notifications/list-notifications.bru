meta {
  name: List Notifications
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/aedst.notifications.v1.NotificationsService/ListNotifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pageSize": 20,
    "unreadOnly": false
  }
}

assert {
  res.status: eq 200
}
