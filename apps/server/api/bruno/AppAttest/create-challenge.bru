meta {
  name: CreateChallenge
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/aedst.appattest.v1.AppAttestService/CreateChallenge
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

docs {
  Needs AEDST_APPATTEST_ENABLED=true; otherwise 400 failed_precondition.
  Returns a single-use 32-byte challenge (base64 in Connect JSON), valid 5 minutes.
}

body:json {
  {}
}

assert {
  res.status: eq 200
}
