# Generated by Tuist — never hand-edited, never committed (ADR-0004).
*.xcodeproj/
*.xcworkspace/

# Tuist local caches/state (per-machine).
.tuist/
.tuist-bin/
.build-cache/

# Swift/Xcode build output.
.build/
DerivedData/
.swiftpm/

# xcresult bundles and snapshot-diff artifacts produced by `mise run test:*`.
.build/artifacts/
*.xcresult

# mise-managed tool installs (machine-local; versions live in mise.toml).
.mise/

# Xcode user state (never shared).
*.xcuserstate
xcuserdata/

.DS_Store

# fastlane's own run artifacts/report — never the Fastfile/Matchfile
# themselves, and never a match-decrypted certificate/profile (those live
# only in the separate match git repo, encrypted, never this one).
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
fastlane/screenshots/
*.ipa
*.dSYM.zip
vendor/bundle/
.bundle/
# fastlane lanes write archives/exports here (Gemfile.lock IS committed).
build/


# Local telemetry keys (Sentry DSN, PostHog key) — copy Secrets.local.xcconfig.example.
Config/Secrets.local.xcconfig
