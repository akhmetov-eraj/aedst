#include "Base.xcconfig"

AEDST_API_ENVIRONMENT = local
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
ONLY_ACTIVE_ARCH = YES

// Push: development-signed builds get APNs sandbox tokens. APS_ENVIRONMENT feeds
// the aps-environment entitlement; AEDST_APNS_SANDBOX tells the server which
// APNs gateway the token belongs to (RegisterPushDevice.apns_sandbox).
APS_ENVIRONMENT = development
AEDST_APNS_SANDBOX = YES
