// Copy to Secrets.local.xcconfig (gitignored). Leave a value empty to keep that SDK off.
// "//" starts a comment in xcconfig files, so URLs are written as https:/$()/...
AEDST_SENTRY_DSN = https:/$()/PUBLIC_KEY@o0.ingest.sentry.io/0
AEDST_POSTHOG_KEY = phc_REPLACE_ME
AEDST_POSTHOG_HOST = https:/$()/eu.i.posthog.com
// Browser sign-in (leave AEDST_OIDC_ISSUER empty to keep first-party email/password).
AEDST_OIDC_ISSUER = https:/$()/idp.example.com
AEDST_OIDC_CLIENT_ID = REPLACE_ME
AEDST_OIDC_AUDIENCE_SCOPE = urn:zitadel:iam:org:project:id:REPLACE_ME:aud
AEDST_OIDC_WEBCREDENTIALS_DOMAIN = idp.example.com
