        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много попыток. Подождите немного и повторите."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кӯшишҳо аз ҳад зиёданд. Лутфан, каме интизор шавед ва бори дигар кӯшиш кунед."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urinishlar juda ko‘p. Biroz kutib, qayta urinib ko‘ring."
          }
        }
      }
    },
