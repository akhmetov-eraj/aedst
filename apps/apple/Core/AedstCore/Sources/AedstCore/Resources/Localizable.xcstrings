{
  "sourceLanguage" : "en",
  "strings" : {
    "errorConflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير هذا في مكان آخر. حدّث الصفحة وحاول مرة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This was changed elsewhere. Refresh and try again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные изменились в другом месте. Обновите и попробуйте снова."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ин дар ҷои дигар тағйир ёфт. Навсозӣ кунед ва бори дигар кӯшиш кунед."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu boshqa joyda oʻzgartirildi. Yangilang va qayta urinib koʻring."
          }
        }
      }
    },
    "errorForbidden" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديك إذن للقيام بذلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have permission to do that."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас нет прав на это действие."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шумо барои ин амал иҷозат надоред."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu amal uchun sizda ruxsat yoʻq."
          }
        }
      }
    },
    "errorNetwork" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الاتصال بالخادم. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach the server. Check your connection and try again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся связаться с сервером. Проверьте подключение и повторите попытку."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пайвастшавӣ бо сервер имконнопазир аст. Пайвастшавиро санҷед ва бори дигар кӯшиш кунед."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverga ulanib bo‘lmadi. Ulanishni tekshirib, qayta urinib ko‘ring."
          }
        }
      }
    },
    "errorNotFound" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم نتمكن من العثور على ما تبحث عنه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find what you were looking for."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось найти запрошенное."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мо чизеро, ки шумо ҷустуҷӯ доштед, ёфта натавонистем."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz izlagan narsa topilmadi."
          }
        }
      }
    },
    "errorRateLimited" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاولات كثيرة جدًا. يرجى الانتظار قليلًا ثم المحاولة مرة أخرى."
