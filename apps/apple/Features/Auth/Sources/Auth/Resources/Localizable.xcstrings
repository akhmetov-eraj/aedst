{
  "sourceLanguage" : "en",
  "strings" : {
    "authBrowserSignInFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إكمال تسجيل الدخول. يرجى المحاولة مرة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign-in could not be completed. Please try again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось выполнить вход. Попробуйте ещё раз."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воридшавӣ анҷом дода нашуд. Лутфан, бори дигар кӯшиш кунед."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirishni yakunlab bo'lmadi. Qaytadan urinib ko'ring."
          }
        }
      }
    },
    "authLoginContinue" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متابعة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжить"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идома додан"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davom etish"
          }
        }
      }
    },
    "authLoginContinueHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تسجيل الدخول في صفحة آمنة. مفاتيح المرور وبيانات الدخول المحفوظة مدعومة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will sign in on a secure page. Passkeys and saved logins are supported."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход выполняется на защищённой странице. Поддерживаются passkey и сохранённые данные для входа."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воридшавӣ дар саҳифаи бехатар анҷом дода мешавад. Passkey ва маълумоти захирашудаи вуруд дастгирӣ мешаванд."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirish xavfsiz sahifada amalga oshiriladi. Passkey va saqlangan kirish ma'lumotlari qo'llab-quvvatlanadi."
          }
        }
      }
    },
