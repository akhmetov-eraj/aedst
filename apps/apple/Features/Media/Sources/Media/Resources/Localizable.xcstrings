    "mediaDeleteConfirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حذف هذا الملف؟ لا يمكن التراجع عن ذلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete this file? This cannot be undone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить этот файл? Это действие нельзя отменить."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ин файлро нест кунед? Ин амалро бекор кардан мумкин нест."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu fayl oʻchirilsinmi? Buni qaytarib boʻlmaydi."
          }
        }
      }
    },
