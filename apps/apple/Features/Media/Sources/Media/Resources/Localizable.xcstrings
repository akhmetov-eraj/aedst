          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замима кардани акс ё видео"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasm yoki video biriktirish"
          }
