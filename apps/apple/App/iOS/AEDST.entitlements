<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications capability. APS_ENVIRONMENT is "development" in Debug and
	  "production" in Release (Config/Debug.xcconfig / Config/Release.xcconfig); the
	  App ID must have Push Notifications enabled and the provisioning profile must
	  include it, or signing fails. Unsigned CI builds (CODE_SIGNING_ALLOWED=NO)
	  ignore entitlements.
	-->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
