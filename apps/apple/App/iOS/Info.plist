<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>AEDST</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
		<string>ar</string>
		<string>tg</string>
		<string>uz</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.aedst.apple.deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aedst</string>
			</array>
		</dict>
		<!-- OIDC redirect "<scheme>:/oauth2redirect"; ASWebAuthenticationSession intercepts it
		     (the app never receives it via onOpenURL). Distinct from the aedst:// deep links. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.aedst.apple.oidc</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(AEDST_OIDC_REDIRECT_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>AEDST_API_ENVIRONMENT</key>
	<string>$(AEDST_API_ENVIRONMENT)</string>
	<key>AEDST_SENTRY_DSN</key>
	<string>$(AEDST_SENTRY_DSN)</string>
	<key>AEDST_POSTHOG_KEY</key>
	<string>$(AEDST_POSTHOG_KEY)</string>
	<key>AEDST_POSTHOG_HOST</key>
	<string>$(AEDST_POSTHOG_HOST)</string>
	<key>AEDST_POSTHOG_SESSION_REPLAY</key>
	<string>$(AEDST_POSTHOG_SESSION_REPLAY)</string>
	<key>AEDST_ROLES_CLAIM</key>
	<string>$(AEDST_ROLES_CLAIM)</string>
	<key>AEDST_OIDC_ISSUER</key>
	<string>$(AEDST_OIDC_ISSUER)</string>
	<key>AEDST_OIDC_CLIENT_ID</key>
	<string>$(AEDST_OIDC_CLIENT_ID)</string>
	<key>AEDST_OIDC_SCOPES</key>
	<string>$(AEDST_OIDC_SCOPES)</string>
	<key>AEDST_OIDC_AUDIENCE_SCOPE</key>
	<string>$(AEDST_OIDC_AUDIENCE_SCOPE)</string>
	<key>AEDST_OIDC_REDIRECT_SCHEME</key>
	<string>$(AEDST_OIDC_REDIRECT_SCHEME)</string>
	<key>AEDST_OIDC_REFRESH_TTL_DAYS</key>
	<string>$(AEDST_OIDC_REFRESH_TTL_DAYS)</string>
	<key>AEDST_OIDC_EPHEMERAL_SESSION</key>
	<string>$(AEDST_OIDC_EPHEMERAL_SESSION)</string>
	<key>AEDST_APNS_SANDBOX</key>
	<string>$(AEDST_APNS_SANDBOX)</string>
	<key>AEDST_APP_STORE_ID</key>
	<string>$(AEDST_APP_STORE_ID)</string>
	<!-- Offline outbox: the system may wake the app to deliver queued writes (BGAppRefreshTask). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.aedst.apple.outbox-sync</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>AEDST uses Face ID to unlock the app and protect your session.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- One window only: KeychainTokenStore.events, ClientUpgradeMonitor.events and AppLinkInbox.links are single-consumer
	     streams, so a second scene would silently stop receiving sign-out, upgrade and link events
	     (decisions/apple.md, "Single window"). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
