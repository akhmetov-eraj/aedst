    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:prod": "cross-env NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100 next build && cross-env CI=1 playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lighthouse": "cross-env NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100 pnpm dlx @lhci/cli@0.15.1 autorun",
    "connect:generate": "node scripts/connect-generate.mjs",
    "knip": "knip",
