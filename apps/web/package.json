{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-seo-placeholders.mjs",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:install": "playwright install chromium",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:prod": "cross-env NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100 next build && cross-env CI=1 playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm check:file-size && pnpm check:colors && pnpm check:forms && pnpm check:deps && pnpm check:feature-boundaries && pnpm check:selftest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --config vitest.storybook.config.mts",
    "test:visual": "cross-env STORYBOOK_VISUAL=1 vitest run --config vitest.storybook.config.mts",
    "test:visual:update": "cross-env STORYBOOK_VISUAL=1 vitest run --config vitest.storybook.config.mts --update",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:colors": "node scripts/check-color-literals.mjs",
    "check:seo": "cross-env AEDST_REQUIRE_REAL_SEO=1 node scripts/check-seo-placeholders.mjs",
    "check:forms": "node scripts/check-forms.mjs",
    "check:selftest": "node scripts/check-selftest.mjs",
    "lighthouse:signed-in": "node scripts/lighthouse-signed-in.mjs",
    "lighthouse": "cross-env NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100 pnpm dlx @lhci/cli@0.15.1 autorun",
    "connect:generate": "node scripts/connect-generate.mjs",
    "knip": "knip",
    "check:feature-boundaries": "bash scripts/check-feature-boundaries.sh",
    "test:contract": "vitest run src/test/contract",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:deps:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot --output-to dep-graph.dot",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "2.2.0",
    "@dnd-kit/react": "^0.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@sentry/nextjs": "^11.5.0",
    "@serwist/turbopack": "^9.5.13",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "idb": "8.0.4",
    "input-otp": "^1.5.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "oauth4webapi": "^3.8.8",
    "posthog-js": "^1.438.2",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@stryker-mutator/core": "10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.5.0",
    "esbuild": "^0.28.2",
    "knip": "^6.40.0",
    "shadcn": "^4.21.4",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
}
