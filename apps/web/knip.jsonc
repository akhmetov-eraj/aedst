{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Entry points knip cannot discover on its own. instrumentation*, proxy.ts,
  // next.config.ts and vitest/playwright configs are auto-detected by plugins.
  "entry": [
    // Loaded by path from next.config.ts (next-intl plugin), not imported.
    "src/app/config/i18n/request.ts",
    // next-intl `AppConfig` type augmentation (Locale), picked up by tsc, never imported.
    "src/app/config/i18n/messages-types.ts",
    // Aliased in place of `server-only` by vitest.config.mts, not imported.
    "src/test/mocks/empty-module.ts",
    // Service worker entry, bundled by Serwist (app/serwist/[path]/route.ts),
    // never imported by the app.
    "src/app/sw.ts",
    // Aliased in place of `@/shared/i18n/navigation` by .storybook/main.ts.
    ".storybook/navigation-stub.tsx",
    "scripts/*.mjs",
    // A module's full public surface (docs/content/web/architecture.md). The signed-in
    // layouts import the single-export files in `entries/` instead, so part of
    // each barrel is no longer imported by the app but stays the supported API.
    "src/modules/*/public.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "ignore": [
    // Vendored shadcn/ui design-system primitives. This is a boilerplate
    // template: the full component set is kept available on purpose, so
    // unused files/exports here are expected, not dead code.
    "src/shared/ui/**",
    // shadcn "utils" alias (components.json); shared/ui imports `cn` directly.
    "src/shared/lib/utils/cn.ts"
  ],
  // Public API surface of template modules, kept complete for first use.
  "ignoreIssues": {
    "src/shared/i18n/locales.ts": ["exports"],
    // Builders for pages that do not exist yet (FAQ, changelog, breadcrumbs); see docs/content/web/seo-geo.md.
    "src/app/config/structured-data.ts": ["exports"],
    "src/shared/i18n/navigation.ts": ["exports"],
    "src/shared/api/connect/client.ts": ["exports"]
  },
  // POLICY (docs/content/library-first.md): libraries on the approved Web
  // stack may be added to package.json BEFORE their first use. Only that
  // explicit allowlist is exempt from "unused dependency". Anything else
  // that is unused must be removed, or added here together with a docs
  // update approving it.
  "ignoreDependencies": [
    // Approved stack, planned but not imported yet.
    "@dnd-kit/react",
    // Referenced only from CSS (@import) or CLI config, which knip does not
    // follow: globals.css, shadcn CLI, buf.gen.yaml / scripts/connect-generate.mjs.
    "shadcn",
    "tw-animate-css",
    "tailwindcss",
    "@bufbuild/buf",
    "@bufbuild/protoc-gen-es",
    // Marker package that only takes effect via a bare side-effect import.
    "client-only",
    // Peer of @axe-core/playwright.
    "axe-core",
    // Built into @stryker-mutator/core; knip infers it from testRunner: "command".
    "@stryker-mutator/command-runner"
  ]
}
