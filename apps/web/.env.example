# --- Public — inlined into the browser bundle at build time. Never put a
# secret here. See src/shared/env/client.ts. ---

# Canonical public origin for this app — metadataBase, canonical/OG URLs,
# sitemap.xml and robots.txt all derive from this (src/app/config/seo.ts).
# Must be an https:// URL in every deployed environment: that is what turns on
# the `__Host-` prefix and Secure flag of the session cookies.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Privacy policy page linked from the consent banner. Empty = no link (set it
# before collecting analytics from real visitors).
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# Search-console ownership tokens (content of the verification <meta> tag, not
# the whole tag). Empty = no tag. See docs/content/web/seo-geo.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Empty locally — the client SDK no-ops without a DSN. Set in
# staging/production only (see "Sentry" below). The DSN also derives the CSP
# violation-report endpoint (report-uri).
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to NODE_ENV. e.g. "staging", "production".
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Share of transactions traced (0..1). Defaults: 1 in dev, 0.2 in production.
# Traces propagate to apps/server (traceparent) so its OpenTelemetry spans join.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Session Replay, only ever after analytics consent, fully masked.
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1

# PostHog product analytics + feature flags. Empty = PostHog is never loaded.
# Loaded only after analytics consent and never when the browser sends
# DNT/GPC. The browser talks to this app's /ingest rewrite, not PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host: https://eu.i.posthog.com, https://us.i.posthog.com
# or a self-hosted instance. Used by the /ingest rewrite in next.config.ts.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Server-only — never sent to the browser. See src/shared/env/server.ts. ---

# apps/server's ConnectRPC address (apps/server's AEDST_HTTP_ADDR). Server-only:
# the browser never talks to it — it calls this app's same-origin `/api/rpc`
# proxy, which attaches the httpOnly-cookie session. In production this is an
# internal service address.
API_BASE_URL=http://localhost:8080

# Base name of the httpOnly session cookies (`<name>` = access token,
# `<name>_refresh` = refresh token, `<name>_id` = OIDC ID token). Over HTTPS they get the `__Host-` prefix
# automatically. Read by src/shared/lib/auth/session-cookies.ts.
AUTH_COOKIE_NAME=aedst_session

# --- OpenID Connect sign-in (Authorization Code + PKCE, backend-for-frontend;
# oauth4webapi). The web app has no password forms and never calls
# apps/server's AuthService. ZITADEL is the default IdP (see
# apps/server/deployments/zitadel/, bootstrap.sh prints these values).
# Register at the IdP: redirect URI <NEXT_PUBLIC_SITE_URL>/api/auth/callback and
# post-logout redirect URI <NEXT_PUBLIC_SITE_URL>. The app must issue JWT
# access tokens. Read lazily: unset values only fail when someone signs in. ---

# Issuer URL = apps/server's AEDST_OIDC_ISSUER. https outside localhost.
OIDC_ISSUER=http://localhost:8085
# Client id of the PKCE application (bootstrap.sh: "aedst-web").
OIDC_CLIENT_ID=
# Only for a confidential client; leave empty for a public PKCE client.
OIDC_CLIENT_SECRET=
# ZITADEL project id = apps/server's AEDST_OIDC_AUDIENCE. Adds the scope
# urn:zitadel:iam:org:project:id:<id>:aud so the access token's aud matches.
OIDC_PROJECT_ID=
# Optional full scope override (space separated), e.g. for Keycloak. Default:
# "openid profile email offline_access" + the project audience scope above.
OIDC_SCOPE=
# Seals the short-lived pre-auth cookie (AES-256-GCM): 32+ random characters,
# identical on every replica. Required in production; development falls back
# to a random per-process key. Generate: openssl rand -base64 32
OIDC_STATE_SECRET=

# Where the roles live in the access token — must match apps/server's
# AEDST_OIDC_ROLES_CLAIM: "urn:zitadel:iam:org:project:roles" for ZITADEL (an
# object keyed by role), "realm_access.roles" for Keycloak, "roles" for an
# array claim. Only decides what the UI shows (admin link, admin pages);
# apps/server enforces roles on every call.
AUTH_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
# Optional ZITADEL organisation id: count only roles granted in that
# organisation (apps/server's AEDST_OIDC_ROLES_ORG). Empty = any.
AUTH_ROLES_ORG=

# Comma-separated object-storage origins that apps/server's presigned media
# URLs point at (S3 / R2 / MinIO), e.g. https://bucket.s3.eu-central-1.amazonaws.com.
# Added to the CSP (connect-src for the direct upload PUT, img-src/media-src
# for variants). Read at runtime by src/proxy.ts. Empty = uploads blocked by CSP.
MEDIA_ORIGINS=http://localhost:9000

# Sentry release/source-map upload during `next build` (see next.config.ts).
# Leave empty locally — the build skips the upload step without it (see
# next.config.ts's `sourcemaps.disable`).
SENTRY_AUTH_TOKEN=

# --- Build-time only — read directly by next.config.ts, before the app
# boots, so these never go through shared/env. Only needed for the
# Sentry source-map upload; irrelevant to running the app locally. ---
SENTRY_ORG=
SENTRY_PROJECT=
# Release name for source maps and events; CI uses the commit SHA
# (GITHUB_SHA is picked up automatically when this is empty).
SENTRY_RELEASE=
