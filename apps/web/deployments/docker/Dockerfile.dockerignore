# Build context is the repository root (see Dockerfile). Keep only what the
# image build reads: apps/web and the proto sources of apps/server.
*
!apps/web
!apps/server/buf.yaml
!apps/server/buf.lock
!apps/server/api/proto

apps/web/node_modules
apps/web/.next
apps/web/coverage
apps/web/storybook-static
apps/web/playwright-report
apps/web/test-results
apps/web/.lighthouseci
apps/web/visual-baselines
apps/web/src/shared/api/connect/generated
**/.env
**/.env.*
!**/.env.example
**/*.tsbuildinfo
