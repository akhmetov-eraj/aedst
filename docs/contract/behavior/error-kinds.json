{
  "behavior": "error-kinds",
  "rules": [
    "Every failure a client surfaces is classified into exactly one of the kinds below; UI, retry policy and crash reporting decide by kind, never by parsing a message.",
    "Platform enum cases use these names (PascalCase on Kotlin and C++, camelCase on Swift and TypeScript). A platform may keep extra local cases (Apple decoding and unsupported) only if they map to kind unknown.",
    "retryable: the same request may succeed later, so backoff or the outbox may try again. reportable: worth a crash-reporter event (a bug or a storage fault); expected states and definitive server answers are control flow, not incidents.",
    "outbox: the verdict an offline-outbox handler derives from the kind. retry records an attempt and stops the run; permanent parks the item and the run continues; blocked stops the run without counting an attempt (session ended, app must be upgraded). Desktop blocks on both kinds, Apple only on upgradeRequired; Web and Android park such items as permanent today (a known gap, not yet part of the offline-outbox fixture).",
    "A Connect code maps to a kind through connectCodes. Two refinements apply after that: failed_precondition carrying the ErrorInfo reason CLIENT_UPGRADE_REQUIRED is upgradeRequired, and a transport failure with no usable connection is offline (unavailable only when the device is online).",
    "Client-side failures without a Connect code: aborted by the caller is cancelled, a client-side deadline is timeout, no connection is offline, a local database failure is storage, anything else is unknown.",
    "cancelled never produces an alert or toast: it is user intent."
  ],
  "kinds": {
    "unauthenticated": { "retryable": false, "reportable": false, "outbox": "blocked" },
    "forbidden": { "retryable": false, "reportable": false, "outbox": "permanent" },
    "notFound": { "retryable": false, "reportable": false, "outbox": "permanent" },
    "invalidInput": { "retryable": false, "reportable": false, "outbox": "permanent" },
    "conflict": { "retryable": false, "reportable": false, "outbox": "permanent" },
    "rateLimited": { "retryable": true, "reportable": false, "outbox": "retry" },
    "unavailable": { "retryable": true, "reportable": false, "outbox": "retry" },
    "offline": { "retryable": true, "reportable": false, "outbox": "retry" },
    "timeout": { "retryable": true, "reportable": false, "outbox": "retry" },
    "cancelled": { "retryable": false, "reportable": false, "outbox": "retry" },
    "upgradeRequired": { "retryable": false, "reportable": false, "outbox": "blocked" },
    "storage": { "retryable": false, "reportable": true, "outbox": "permanent" },
    "unknown": { "retryable": false, "reportable": true, "outbox": "permanent" }
  },
  "connectCodes": {
    "canceled": "cancelled",
    "unknown": "unknown",
    "invalid_argument": "invalidInput",
    "deadline_exceeded": "timeout",
    "not_found": "notFound",
    "already_exists": "conflict",
    "permission_denied": "forbidden",
    "resource_exhausted": "rateLimited",
    "failed_precondition": "invalidInput",
    "aborted": "conflict",
    "out_of_range": "invalidInput",
    "unimplemented": "unknown",
    "internal": "unknown",
    "unavailable": "unavailable",
    "data_loss": "unknown",
    "unauthenticated": "unauthenticated"
  },
  "cases": [
    { "id": "unauthenticated", "code": "unauthenticated", "expect": { "kind": "unauthenticated", "retryable": false, "reportable": false } },
    { "id": "permission-denied-is-forbidden-not-signed-out", "code": "permission_denied", "expect": { "kind": "forbidden", "retryable": false, "reportable": false } },
    { "id": "not-found", "code": "not_found", "expect": { "kind": "notFound", "retryable": false, "reportable": false } },
    { "id": "invalid-argument", "code": "invalid_argument", "expect": { "kind": "invalidInput", "retryable": false, "reportable": false } },
    { "id": "out-of-range", "code": "out_of_range", "expect": { "kind": "invalidInput", "retryable": false, "reportable": false } },
    { "id": "failed-precondition-is-invalid-input", "code": "failed_precondition", "expect": { "kind": "invalidInput", "retryable": false, "reportable": false } },
    { "id": "upgrade-required-overrides-failed-precondition", "code": "failed_precondition", "reason": "CLIENT_UPGRADE_REQUIRED", "expect": { "kind": "upgradeRequired", "retryable": false, "reportable": false } },
    { "id": "other-reason-stays-invalid-input", "code": "failed_precondition", "reason": "SOMETHING_ELSE", "expect": { "kind": "invalidInput", "retryable": false, "reportable": false } },
    { "id": "aborted-is-conflict", "code": "aborted", "expect": { "kind": "conflict", "retryable": false, "reportable": false } },
    { "id": "already-exists-is-conflict", "code": "already_exists", "expect": { "kind": "conflict", "retryable": false, "reportable": false } },
    { "id": "resource-exhausted-is-rate-limited", "code": "resource_exhausted", "expect": { "kind": "rateLimited", "retryable": true, "reportable": false } },
    { "id": "unavailable-online", "code": "unavailable", "expect": { "kind": "unavailable", "retryable": true, "reportable": false } },
    { "id": "deadline-exceeded-is-timeout", "code": "deadline_exceeded", "expect": { "kind": "timeout", "retryable": true, "reportable": false } },
    { "id": "canceled-is-cancelled", "code": "canceled", "expect": { "kind": "cancelled", "retryable": false, "reportable": false } },
    { "id": "internal-is-unknown", "code": "internal", "expect": { "kind": "unknown", "retryable": false, "reportable": true } },
    { "id": "unimplemented-is-unknown", "code": "unimplemented", "expect": { "kind": "unknown", "retryable": false, "reportable": true } },
    { "id": "data-loss-is-unknown", "code": "data_loss", "expect": { "kind": "unknown", "retryable": false, "reportable": true } },
    { "id": "unknown-code", "code": "unknown", "expect": { "kind": "unknown", "retryable": false, "reportable": true } },
    { "id": "transport-failure-while-offline", "transport": "offline", "expect": { "kind": "offline", "retryable": true, "reportable": false } },
    { "id": "client-side-timeout", "transport": "timeout", "expect": { "kind": "timeout", "retryable": true, "reportable": false } },
    { "id": "caller-aborted", "transport": "aborted", "expect": { "kind": "cancelled", "retryable": false, "reportable": false } },
    { "id": "local-database-failure", "transport": "storage", "expect": { "kind": "storage", "retryable": false, "reportable": true } }
  ]
}
