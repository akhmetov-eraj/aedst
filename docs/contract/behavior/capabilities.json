{
  "behavior": "capability-negotiation",
  "rules": [
    "A feature is shown only if the client build includes it AND the server capabilities enable it.",
    "Unknown server features are ignored (never crash).",
    "Built-in features default to enabled when no capabilities have ever been fetched; flagged features default to disabled.",
    "A failed fetch falls back to the last known capabilities, then to the defaults above.",
    "A feature that lists requiredClientVersion is hidden on older clients even if enabled."
  ],
  "clientBuild": {
    "platform": "android",
    "version": "1.3.0",
    "features": ["tasks", "media", "search", "admin", "notifications", "auth"],
    "flagged": ["admin"]
  },
  "cases": [
    { "id": "enabled-and-built", "server": { "features": { "tasks": { "enabled": true } } }, "lastKnown": null, "expect": { "tasks": true } },
    { "id": "disabled-by-server", "server": { "features": { "search": { "enabled": false } } }, "lastKnown": null, "expect": { "search": false } },
    { "id": "unknown-feature-ignored", "server": { "features": { "teleport": { "enabled": true } } }, "lastKnown": null, "expect": { "teleport": false } },
    { "id": "builtin-default-enabled-without-fetch", "server": null, "lastKnown": null, "expect": { "tasks": true, "admin": false } },
    { "id": "fetch-failure-uses-last-known", "server": null, "lastKnown": { "features": { "search": { "enabled": false }, "admin": { "enabled": true } } }, "expect": { "search": false, "admin": true } },
    { "id": "required-client-version-hides-feature", "server": { "features": { "media": { "enabled": true, "requiredClientVersion": "1.4.0" } } }, "lastKnown": null, "expect": { "media": false } }
  ]
}
