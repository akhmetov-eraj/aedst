# Exceptions for scripts/check-docs.mjs. Format: <rule|*> <glob>  (rules: links, paths, prompts, frontmatter, cyrillic)
# links/paths/prompts: glob matches the mentioned path as written. cyrillic: glob matches the file.
# Every entry needs a reason in the comment above it.

# Android default locale (res/values) is Russian by product decision; the other locales are values-*.
cyrillic **/res/values/strings.xml
# Apple per-locale permission strings and Android/Apple/desktop test data that assert Cyrillic input handling.
cyrillic **/*.lproj/*.strings
# Build outputs mentioned by CI upload steps; they exist only after a build.
paths apps/web/.lighthouseci-signed-in/
# Visual-regression baselines: created by web-record-baselines.yml (artifact) and committed afterwards.
paths apps/web/visual-baselines
paths apps/web/visual-baselines/
paths apps/android/app/src/release/generated/baselineProfiles/
paths apps/desktop/perf-report.json
paths apps/desktop/verify-pkg
# Test data that deliberately contains non-English text (unicode handling tests).
cyrillic apps/android/benchmark/src/main/kotlin/com/aedst/benchmark/BenchmarkSession.kt
cyrillic apps/android/core/ui/src/test/**
cyrillic apps/server/internal/platform/idempotency/interceptor_test.go
cyrillic apps/web/src/shared/lib/auth/session-claims.test.ts
# Hook smoke-test fixtures: scripts/check-hooks.sh feeds fabricated paths to the hooks.
paths apps/server/internal/modules/tasks/infrastructure/postgres/sqlc/query.sql.go
paths apps/server/gen/aedst/tasks/v1/tasksv1connect/tasks.connect.go
paths apps/desktop/Modules/Core/DesignSystem/qml/AedstTokens.qml
paths apps/server/internal/modules/tasks/domain/task.go
paths apps/web/src/types/messages.d.ts
paths apps/desktop/Modules/__no_such_file__.cpp
# Runtime log written by the CI load job.
paths apps/server/server.log
# Runtime log written by the desktop MSVC clang-tidy CI step.
paths apps/desktop/clang-tidy-msvc.log
# Native-script language names in the locale switcher story (a language picker shows each language in its own script).
cyrillic apps/web/src/shared/ui/locale-select.stories.tsx
# CI-generated artifacts (web-ci import graph and mutation report).
paths apps/web/dep-graph.svg
paths apps/web/reports/mutation/
