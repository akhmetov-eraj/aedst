# Configuration for scripts/check-file-size.sh (policy: CONVENTIONS.md, "File size").
# Line format: `<key> <value>`; '#' starts a comment; blank lines are ignored.
#
#   yellow  <n>   lines above which a file is yellow (default 300)
#   orange  <n>   lines above which a file is a high warning (default 400)
#   red     <n>   lines above which a file FAILS the check (default 500)
#   ext     <e>   file extension (no dot) that counts as hand-written source
#   exclude <g>   bash glob matched against the repo-relative path (`*` crosses '/')
#
# Only hand-written source is measured: files are taken from `git ls-files` (tracked and
# untracked-but-not-ignored), then filtered by `ext` and `exclude`. Generated, vendor, lock and
# data files must be listed here, never silently skipped in code.

yellow 300
orange 400
red 500

# --- measured source extensions ---------------------------------------------
ext ts
ext tsx
ext js
ext mjs
ext go
ext kt
ext kts
ext swift
ext qml
ext cpp
ext hpp
ext h
ext cc
ext c
ext sh
ext sql

# --- generated code -----------------------------------------------------------
exclude apps/server/gen/*
exclude apps/server/internal/*/sqlc/*
exclude apps/server/internal/*/db/*.sql.go
exclude *.pb.go
exclude *.pb.*
exclude *_connect.go
exclude *.connect.*
exclude *_pb.ts
exclude *_pb.js
exclude apps/web/src/shared/api/*/generated/*
exclude apps/web/src/gen/*
exclude apps/web/next-env.d.ts
exclude *.d.ts
exclude apps/web/src/shared/ui/tokens.css
exclude apps/android/core/network/src/main/kotlin-gen/*
exclude apps/apple/Core/*/Generated/*
exclude apps/apple/*/Derived/*
exclude apps/desktop/*/generated/*
exclude apps/desktop/docs/generated/*
exclude packages/design-tokens/dist/*
exclude */AedstTokens.qml
exclude */AedstLightPalette.*
exclude */AedstDarkPalette.*

# --- vendor / build output ----------------------------------------------------
exclude */node_modules/*
exclude */.next/*
exclude */build/*
exclude */dist/*
exclude */vcpkg_installed/*
exclude */.build/*
exclude */.gradle/*
exclude */Pods/*
exclude */third_party/*
exclude */vendor/*

# --- SQL migrations are append-only history, not refactorable units -----------
exclude apps/server/migrations/*
exclude apps/server/db/migrations/*
exclude apps/server/internal/*/migrations/*

# --- shadcn/ui generated primitives (kept verbatim to ease upstream updates) -----
# Primitives under apps/web/src/shared/ui are measured like everything else; add a line here only
# when a specific vendored file legitimately exceeds the limit, with a reason.
