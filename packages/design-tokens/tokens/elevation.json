{
  "elevation": {
    "$type": "dimension",
    "$description": "Elevation scale for cards, sheets, dialogs and popovers (dp on Android; shadow radius reference elsewhere).",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "level1": { "$value": { "value": 1, "unit": "px" } },
    "level2": { "$value": { "value": 3, "unit": "px" } },
