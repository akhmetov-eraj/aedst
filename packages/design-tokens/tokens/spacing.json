{
  "spacing": {
    "$type": "dimension",
    "$description": "Spacing scale on the 4px grid. Values are dp on Android, pt on Apple, logical px on web/desktop.",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xxs": { "$value": { "value": 2, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 20, "unit": "px" } },
    "xxl": { "$value": { "value": 24, "unit": "px" } },
    "xxxl": { "$value": { "value": 32, "unit": "px" } },
    "huge": { "$value": { "value": 40, "unit": "px" } },
    "massive": { "$value": { "value": 48, "unit": "px" } },
    "giant": { "$value": { "value": 64, "unit": "px" } }
  }
}
