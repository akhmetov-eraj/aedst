{
  "radius": {
    "$type": "dimension",
    "$description": "Corner radius scale. `lg` is web's --radius base (0.625rem); web derives sm/md/xl/2xl/3xl from it (x0.6, 0.8, 1.4, 1.8, 2.2).",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": {
      "$value": { "value": 10, "unit": "px" },
      "$extensions": { "com.aedst": { "cssName": "radius" } }
    },
    "xl": { "$value": { "value": 14, "unit": "px" } },
    "xxl": { "$value": { "value": 18, "unit": "px" } },
    "xxxl": { "$value": { "value": 22, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  }
}
